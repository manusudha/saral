# ---- Sarvam (voice in + voice out) ----
# Get a key at https://dashboard.sarvam.ai
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v4
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=priya

# ---- AI model (agent + reading document photos) ----
# Any OpenAI-compatible chat API with vision. Examples:
#   Gemini : LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai   LLM_MODEL=gemini-2.5-flash
#   OpenAI : LLM_BASE_URL=https://api.openai.com/v1                                LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash

# ---- n8n (optional) ----
# Production URL of a Webhook node (POST). Leave empty to skip.
N8N_WEBHOOK_URL=

# ---- Database (optional) ----
# SQLite file. Defaults to data/saral.db. On Vercel use /tmp/saral.db
# DB_PATH=
